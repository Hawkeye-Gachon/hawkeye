{
  "schemaVersion": 1,
  "models": [
    {
      "id": "eye-state-resnet18",
      "version": "REPLACE-WITH-TRAINING-RUN-ID",
      "file": "REPLACE_WITH_EYE_MODEL.onnx",
      "description": "예시 항목. 한쪽 눈 크롭으로 열림/감김을 분류하는 모델을 가정한 값이며 실제 학습 설정으로 모두 바꿔야 합니다.",
      "inputRegion": "EYE_CROP",
      "input": {
        "name": "input",
        "width": 64,
        "height": 64,
        "layout": "NCHW",
        "colorOrder": "RGB",
        "dtype": "FLOAT32",
        "normalization": {
          "type": "MEAN_STD",
          "pixelScale": 255.0,
          "mean": [0.485, 0.456, 0.406],
          "std": [0.229, 0.224, 0.225]
        },
        "mirrorHorizontally": false,
        "cropScale": 0.9
      },
      "output": {
        "name": "logits",
        "kind": "SOFTMAX_LOGITS",
        "classes": [
          { "label": "open", "meaning": "EYES_OPEN" },
          { "label": "closed", "meaning": "EYES_CLOSED" }
        ],
        "minConfidence": 0.6,
        "eyeAggregation": "MEAN_PROBABILITY"
      }
    }
  ]
}

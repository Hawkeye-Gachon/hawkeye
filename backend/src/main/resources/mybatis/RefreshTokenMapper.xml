<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.contest.DriverGuard.auth.dao.RefreshTokenDao">

    <insert id="insertRefreshToken"
            parameterType="com.contest.DriverGuard.auth.dto.AuthDto$RefreshToken"
            useGeneratedKeys="true"
            keyProperty="tokenId"
            keyColumn="token_id">
        INSERT INTO refresh_tokens (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt})
    </insert>

    <!-- DELETE ... RETURNING 은 결과를 받아야 해서 select 로 선언 -->
    <select id="deleteValidByHash" resultType="java.lang.Long" flushCache="true" useCache="false">
        DELETE FROM refresh_tokens
        WHERE token_hash = #{tokenHash}
          AND expires_at > now()
        RETURNING user_id
    </select>

    <delete id="deleteByHash">
        DELETE FROM refresh_tokens
        WHERE token_hash = #{tokenHash}
    </delete>

    <delete id="deleteExpiredByUserId">
        DELETE FROM refresh_tokens
        WHERE user_id = #{userId}
          AND expires_at &lt;= now()
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM refresh_tokens
        WHERE user_id = #{userId}
    </delete>

</mapper>